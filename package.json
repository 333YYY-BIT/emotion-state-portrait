{
  "name": "emotion-state-portrait",
  "version": "1.0.5",
  "description": "情绪·状态·人物画像引擎：303 情绪词分层打分、冷门探索奖励、同类冷却，精神值阶梯与彩蛋式状态跃迁，file/onebot 双模式",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "qq-emotion.mjs",
    "qq-emotion-ui.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "emotion/config.example.json",
    "emotion/ui.html",
    "docs/*.md",
    "examples/**",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "update": "node qq-emotion.mjs update",
    "status": "node qq-emotion.mjs status",
    "ui": "node qq-emotion-ui.mjs"
  },
  "keywords": [
    "ai",
    "emotion",
    "mood",
    "persona",
    "llm",
    "roleplay",
    "dsh-plugin"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/333YYY-BIT/emotion-state-portrait.git"
  },
  "homepage": "https://github.com/333YYY-BIT/emotion-state-portrait",
  "bin": {
    "emotion-state-portrait": "qq-emotion.mjs",
    "emotion-portrait": "qq-emotion.mjs"
  }
}

{
  "name": "emotion-state-portrait",
  "version": "1.0.0",
  "description": "情绪 · 状态 · 人物画像引擎：给 LLM 角色情绪连续性、精神值状态与按人画像，file 模式可接任何 AI",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "qq-emotion.mjs",
    "qq-emotion-ui.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "emotion/**",
    "docs/*.md",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "update": "node qq-emotion.mjs update",
    "status": "node qq-emotion.mjs status",
    "ui": "node qq-emotion-ui.mjs"
  },
  "keywords": ["ai", "emotion", "mood", "persona", "llm", "roleplay", "dsh-plugin"],
  "license": "MIT",
  "optionalDependencies": {
    "ws": "^8.18.0"
  }
}
